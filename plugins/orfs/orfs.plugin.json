{
  "schema_version": 3,
  "plugin_id": "orfs",
  "plugin_version": "1.0.0",
  "adapter_entry": ["python3", "./adapter.py"],
  "capabilities": ["eda.rtl_to_gds"],
  "supported_arch": ["aarch64", "x86_64", "arm64"],
  "default_timeout_seconds": 7200,
  "artifact_rules": [
    {"kind": "report", "required": true},
    {"kind": "log", "required": false},
    {"kind": "odb", "required": false},
    {"kind": "def", "required": false},
    {"kind": "gds", "required": false},
    {"kind": "netlist", "required": false}
  ],
  "progress_marker": "[progress]",
  "environment": {}
}
