{
  "schema_version": 3,
  "plugin_id": "orfs-evaluator",
  "plugin_version": "1.0.0",
  "adapter_entry": ["python3", "./adapter.py"],
  "capabilities": ["evaluate.protected"],
  "supported_arch": ["aarch64", "x86_64", "arm64"],
  "default_timeout_seconds": 600,
  "artifact_rules": [
    {"kind": "protected_evaluation", "required": true}
  ],
  "progress_marker": "[progress]",
  "requirements": {
    "require_protected_evaluation": false
  },
  "environment": {}
}
